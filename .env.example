# None of these are required for a local scan + score.
# Copy to .env locally. Never commit .env.

# Optional Postgres. Without it, PGLite holds the catalog.
# DATABASE_URL=postgres://user:pass@localhost:5432/healthie

# Optional pack-photo assist (xAI).
# XAI_API_KEY=

# USDA FoodData Central. Leave unset to use DEMO_KEY (rate-thin).
# FDC_API_KEY=

# Public hostname when deploying.
# VITE_PUBLIC_HOSTNAME=
# VITE_AUTH_ENABLED=true
