# Healthie — none of these are required for a local scan + score.

# Optional Postgres. Without it, PGLite on this machine holds the catalog.
# DATABASE_URL=postgres://user:pass@localhost:5432/healthie

# Optional pack-photo assist (xAI). Without it, local barcode + still reading still run.
# XAI_API_KEY=

# Leave unset unless you are deploying behind a public hostname.
# VITE_PUBLIC_HOSTNAME=
# VITE_AUTH_ENABLED=true
