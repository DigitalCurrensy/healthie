{
  "id": "/",
  "name": "Healthie",
  "short_name": "Healthie",
  "description": "Independent scores for food, beauty, and pet. Scan a pack. Read what’s in it.",
  "start_url": "/scan",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#F1F0EB",
  "theme_color": "#102E28",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/apple-touch.png", "sizes": "180x180", "type": "image/png" },
    { "src": "/brand/og-logo.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ]
}
